{
  "model": "effnet",
  "size": 512,
  "view": "concat",
  "requires_initialization": true,
  "use_age": true,
  "epochs": 24,
  "patience": 4,
  "batch_size": 4,
  "accumulation": 8,
  "head_warmup_epochs": 2,
  "backbone_lr": 0.0001,
  "head_lr": 0.001,
  "ema_decay": 0.999,
  "gradient_checkpointing": true,
  "pretrained": "weights/effnet_source.json",
  "roi_scales": [
    3,
    5
  ],
  "local_size": 512,
  "local_sizes": [512, 672]
}
